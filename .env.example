APP_NAME=AFREN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afren
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Use "log" in development; set real SMTP details in production
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="recruitment@afren.africa"
MAIL_FROM_NAME="${APP_NAME}"

# First super-admin created by `php artisan db:seed`
AFREN_ADMIN_NAME="AFREN Admin"
AFREN_ADMIN_EMAIL=admin@afren.test
AFREN_ADMIN_PASSWORD=ChangeMe!12345
# Comma-separated list notified of new requests/registrations (defaults to all admins)
AFREN_NOTIFY_EMAILS=
